# 복사해서 .env 로 쓰세요. (.env 는 절대 커밋하지 않습니다)

# ---- LLM ----
OPENAI_API_KEY=
# OpenAI 호환 프록시를 쓸 때만 입력 (비우면 OpenAI 기본 주소)
OPENAI_BASE_URL=
LLM_MODEL=

# ---- 외부 API ----
# 공공데이터포털 일반 인증키 (Decoding 키) — 고캠핑 · 전기차 충전소 공용
DATA_GO_KR_SERVICE_KEY=
# 카카오 디벨로퍼스 REST API 키 — 로컬(주소 검색) · 자동차 길찾기 공용
KAKAO_REST_API_KEY=
# Open-Meteo 는 키가 필요 없습니다

# ---- 실행 설정 ----
MAX_REPLAN=3
WORKER_MAX_RETRY=1
TOOL_TIMEOUT_SEC=10
DB_PATH=./data/app.db

# ---- check_apis.py ----
CHECK_ORIGIN_ADDRESS=서울특별시 중구 세종대로 110
